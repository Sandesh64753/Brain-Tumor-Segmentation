# NeuroScan AI Environment Configuration

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL=sqlite:///./neuroscan.db
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/neuroscan_db

# Security
SECRET_KEY=neuroscan_super_secret_jwt_key_2026_change_in_production!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Model Storage Paths
CLASSIFICATION_MODEL_PATH=trained_models/classification/best_classifier.pth
SEGMENTATION_MODEL_PATH=trained_models/segmentation/best_segmenter.pth

# Inference Device (cpu, cuda, cuda:0)
DEVICE=cpu

# Model Metadata & Hyperparameters
CLASS_NAMES=["Glioma", "Meningioma", "Pituitary", "No Tumor"]
IMAGE_SIZE=224
GRADCAM_TARGET_LAYER=layer4

# File Upload Limits
MAX_UPLOAD_SIZE_MB=10

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
